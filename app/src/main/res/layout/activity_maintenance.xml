<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pure_bg"
    tools:context=".MaintenanceActivity">

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.2"
        android:background="@drawable/bg_scanlines" />

    <LinearLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="20dp"
        app:layout_constraintTop_toTopOf="parent">
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MAINTENANCE"
                android:textColor="@color/pure_cy"
                android:textSize="20sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Scheduled Tasks"
                android:textColor="@color/pure_mu"
                android:textSize="10sp" />
        </LinearLayout>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_badge_green"
            android:backgroundTint="#26FF8800"
            android:paddingHorizontal="12dp"
            android:paddingVertical="4dp"
            android:text="1 OVERDUE"
            android:textColor="@color/pure_or"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/header"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Calendar View (Grid) from HTML -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                app:cardBackgroundColor="@color/pure_bg2"
                app:cardCornerRadius="16dp"
                app:strokeColor="@color/pure_br"
                app:strokeWidth="1dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="12dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="📅" android:textSize="18sp" />
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="12dp" android:text="April 2026" android:textColor="@color/pure_tx" android:textStyle="bold" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Next: Apr 28" android:textColor="@color/pure_mu" android:textSize="10sp" />
                    </LinearLayout>
                    <!-- Calendar Simulation Grid -->
                    <GridLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:columnCount="7"
                        android:alignmentMode="alignMargins"
                        android:columnOrderPreserved="false">
                        <!-- M T W T F S S -->
                        <TextView android:text="M" android:textColor="@color/pure_dm" android:textSize="8sp" android:gravity="center" android:layout_columnWeight="1" />
                        <TextView android:text="T" android:textColor="@color/pure_dm" android:textSize="8sp" android:gravity="center" android:layout_columnWeight="1" />
                        <TextView android:text="W" android:textColor="@color/pure_dm" android:textSize="8sp" android:gravity="center" android:layout_columnWeight="1" />
                        <TextView android:text="T" android:textColor="@color/pure_dm" android:textSize="8sp" android:gravity="center" android:layout_columnWeight="1" />
                        <TextView android:text="F" android:textColor="@color/pure_dm" android:textSize="8sp" android:gravity="center" android:layout_columnWeight="1" />
                        <TextView android:text="S" android:textColor="@color/pure_dm" android:textSize="8sp" android:gravity="center" android:layout_columnWeight="1" />
                        <TextView android:text="S" android:textColor="@color/pure_dm" android:textSize="8sp" android:gravity="center" android:layout_columnWeight="1" />

                        <!-- Empty for padding -->
                        <TextView android:text="21" android:textColor="@color/pure_dm" android:textSize="10sp" android:padding="4dp" android:gravity="center" />
                        <TextView android:text="22" android:textColor="@color/pure_dm" android:textSize="10sp" android:padding="4dp" android:gravity="center" />
                        <TextView android:text="23" android:textColor="@color/pure_dm" android:textSize="10sp" android:padding="4dp" android:gravity="center" />
                        <TextView android:text="24" android:textColor="@color/pure_cy" android:textSize="10sp" android:padding="4dp" android:gravity="center" android:textStyle="bold" android:background="@drawable/bg_badge_green" android:backgroundTint="#2600D4FF" />
                        <TextView android:text="25" android:textColor="@color/pure_mu" android:textSize="10sp" android:padding="4dp" android:gravity="center" />
                        <TextView android:text="26" android:textColor="@color/pure_mu" android:textSize="10sp" android:padding="4dp" android:gravity="center" />
                        <TextView android:text="27" android:textColor="@color/pure_mu" android:textSize="10sp" android:padding="4dp" android:gravity="center" />
                        <TextView android:text="28" android:textColor="@color/pure_gn" android:textSize="10sp" android:padding="4dp" android:gravity="center" android:textStyle="bold" />
                    </GridLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Tasks -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="#26120800"
                app:cardCornerRadius="14dp"
                app:strokeColor="#59FF8800"
                app:strokeWidth="1dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🧹" android:textSize="24sp" />
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="12dp" android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Tank Cleaning" android:textColor="@color/pure_tx" android:textStyle="bold" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Overdue 3 days" android:textColor="@color/pure_or" android:textSize="10sp" />
                        </LinearLayout>
                        <com.google.android.material.button.MaterialButton android:layout_width="wrap_content" android:layout_height="32dp" android:text="FIX" android:textSize="8sp" android:backgroundTint="@color/pure_rd" android:padding="0dp" app:cornerRadius="4dp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="TASK_LOG" android:textColor="@color/pure_dm" android:textSize="10sp" android:letterSpacing="0.2" />
            <!-- Log entries follow... -->

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>