<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pure_bg"
    tools:context=".HistoryActivity">

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.2"
        android:background="@drawable/bg_scanlines" />

    <LinearLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="20dp"
        app:layout_constraintTop_toTopOf="parent">
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ANALYTICS"
                android:textColor="@color/pure_cy"
                android:textSize="20sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Water Quality History"
                android:textColor="@color/pure_mu"
                android:textSize="10sp" />
        </LinearLayout>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_badge_green"
            android:backgroundTint="#2600D4FF"
            android:paddingHorizontal="12dp"
            android:paddingVertical="4dp"
            android:text="LIVE DATA"
            android:textColor="@color/pure_cy"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/header"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="16dp">
                <TextView android:layout_width="0dp" android:layout_height="32dp" android:layout_weight="1" android:text="DAY" android:textColor="@color/pure_mu" android:gravity="center" android:textSize="9sp" android:background="@drawable/bg_badge_green" android:backgroundTint="#0DFFFFFF" android:layout_marginEnd="4dp" />
                <TextView android:layout_width="0dp" android:layout_height="32dp" android:layout_weight="1" android:text="WEEK" android:textColor="@color/pure_cy" android:gravity="center" android:textSize="9sp" android:background="@drawable/bg_badge_green" android:backgroundTint="#2600D4FF" android:textStyle="bold" android:layout_marginHorizontal="2dp" />
                <TextView android:layout_width="0dp" android:layout_height="32dp" android:layout_weight="1" android:text="MONTH" android:textColor="@color/pure_mu" android:gravity="center" android:textSize="9sp" android:background="@drawable/bg_badge_green" android:backgroundTint="#0DFFFFFF" android:layout_marginStart="4dp" />
            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                app:cardBackgroundColor="@color/pure_bg2"
                app:cardCornerRadius="16dp"
                app:strokeColor="@color/pure_br"
                app:strokeWidth="1dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="TURBIDITY NTU · 7-day" android:textColor="@color/pure_mu" android:textSize="10sp" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Avg 1.8" android:textColor="@color/pure_cy" android:textSize="14sp" android:textStyle="bold" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="120dp"
                        android:layout_marginTop="16dp"
                        android:background="#0D00D4FF" />

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="8dp">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="MON" android:textColor="@color/pure_dm" android:textSize="8sp" android:gravity="center" />
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="TUE" android:textColor="@color/pure_dm" android:textSize="8sp" android:gravity="center" />
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="WED" android:textColor="@color/pure_dm" android:textSize="8sp" android:gravity="center" />
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="THU" android:textColor="@color/pure_dm" android:textSize="8sp" android:gravity="center" />
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="FRI" android:textColor="@color/pure_dm" android:textSize="8sp" android:gravity="center" />
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="SAT" android:textColor="@color/pure_dm" android:textSize="8sp" android:gravity="center" />
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="SUN" android:textColor="@color/pure_dm" android:textSize="8sp" android:gravity="center" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="20dp">

                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:padding="10dp" android:background="@color/pure_bg2" android:gravity="center">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="MIN" android:textColor="@color/pure_dm" android:textSize="8sp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0.8" android:textColor="@color/pure_gn" android:textSize="16sp" android:textStyle="bold" />
                </LinearLayout>
                <View android:layout_width="4dp" android:layout_height="1dp" />
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:padding="10dp" android:background="@color/pure_bg2" android:gravity="center">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="AVG" android:textColor="@color/pure_dm" android:textSize="8sp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="1.8" android:textColor="@color/pure_cy" android:textSize="16sp" android:textStyle="bold" />
                </LinearLayout>
                <View android:layout_width="4dp" android:layout_height="1dp" />
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:padding="10dp" android:background="@color/pure_bg2" android:gravity="center">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="MAX" android:textColor="@color/pure_dm" android:textSize="8sp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="4.8" android:textColor="@color/pure_rd" android:textSize="16sp" android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="EVENT LOG" android:textColor="@color/pure_dm" android:textSize="10sp" android:letterSpacing="0.2" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="8dp"
                app:cardBackgroundColor="@color/pure_bg2"
                app:cardCornerRadius="12dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="12dp" android:gravity="center_vertical">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Quality spike detected" android:textColor="@color/pure_tx" android:textSize="12sp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Sun 09:12" android:textColor="@color/pure_rd" android:textSize="10sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.button.MaterialButton
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="20dp"
                android:text="📥 EXPORT REPORT PDF"
                android:textColor="@color/pure_bg"
                android:backgroundTint="@color/pure_cy"
                android:textStyle="bold"
                app:cornerRadius="12dp" />

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>