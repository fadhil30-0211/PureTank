<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pure_bg"
    tools:context=".MainActivity">

    <!-- Header -->
    <LinearLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="20dp"
        app:layout_constraintTop_toTopOf="parent">
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PURETANK"
                android:textColor="@color/pure_cy"
                android:textSize="20sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Smart Water Monitor · Tank A"
                android:textColor="@color/pure_mu"
                android:textSize="10sp" />
        </LinearLayout>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_badge_green"
            android:paddingHorizontal="12dp"
            android:paddingVertical="4dp"
            android:text="ONLINE"
            android:textColor="@color/pure_gn"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <View
        android:id="@+id/scanlineOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.3"
        android:background="@drawable/bg_scanlines"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Main Gauge -->
    <FrameLayout
        android:id="@+id/gaugeFrame"
        android:layout_width="220dp"
        android:layout_height="220dp"
        android:layout_marginTop="10dp"
        app:layout_constraintTop_toBottomOf="@id/header"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ProgressBar
            android:id="@+id/gaugeProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:indeterminate="false"
            android:max="100"
            android:progress="87"
            android:progressDrawable="@drawable/circular_gauge_cyan" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical">
            <TextView
                android:id="@+id/tvGaugeNum"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="87"
                android:textColor="@color/pure_cy"
                android:textSize="48sp"
                android:textStyle="bold"
                android:shadowColor="@color/pure_cy"
                android:shadowDx="0"
                android:shadowDy="0"
                android:shadowRadius="15" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="NTU Clarity"
                android:textColor="@color/pure_mu"
                android:textSize="12sp" />
        </LinearLayout>
    </FrameLayout>

    <!-- Wave Decoration (Cyber Style) -->
    <FrameLayout
        android:id="@+id/waveContainer"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="16dp"
        android:background="#0D001432"
        app:layout_constraintTop_toBottomOf="@id/gaugeFrame">

        <View
            android:id="@+id/waveView1"
            android:layout_width="match_parent"
            android:layout_height="34dp"
            android:layout_gravity="bottom"
            android:background="#2E00D4FF" />

        <View
            android:id="@+id/waveView2"
            android:layout_width="match_parent"
            android:layout_height="28dp"
            android:layout_gravity="bottom"
            android:background="#1A00D4FF" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="AQUA FLOW ACTIVE"
            android:textColor="@color/pure_cy2"
            android:textSize="9sp"
            android:letterSpacing="0.2"
            android:textStyle="bold" />
    </FrameLayout>

    <!-- Tank Visual Card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/tankCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="16dp"
        app:cardBackgroundColor="@color/pure_bg2"
        app:cardCornerRadius="16dp"
        app:strokeColor="@color/pure_br"
        app:strokeWidth="1dp"
        app:layout_constraintTop_toBottomOf="@id/waveContainer">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="16dp"
            android:gravity="center_vertical">

            <FrameLayout
                android:layout_width="40dp"
                android:layout_height="60dp"
                android:background="@drawable/bg_tank_outline">
                <View
                    android:id="@+id/tankFill"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_gravity="bottom"
                    android:background="@color/pure_cy"
                    android:alpha="0.6"/>
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="16dp"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Water Level"
                    android:textColor="@color/pure_tx"
                    android:textSize="12sp" />
                <TextView
                    android:id="@+id/tvTankPct"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="72%"
                    android:textColor="@color/pure_cy"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:shadowColor="@color/pure_cy"
                    android:shadowDx="0"
                    android:shadowDy="0"
                    android:shadowRadius="10" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_badge_green"
                android:paddingHorizontal="10dp"
                android:paddingVertical="2dp"
                android:text="STABLE"
                android:textColor="@color/pure_gn"
                android:textSize="9sp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Sensors Grid -->
    <GridLayout
        android:id="@+id/sensorGrid"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="12dp"
        android:columnCount="2"
        android:rowCount="2"
        app:layout_constraintTop_toBottomOf="@id/tankCard">

        <!-- Turbidity -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:layout_margin="4dp"
            app:cardBackgroundColor="@color/pure_bg2"
            app:cardCornerRadius="12dp"
            app:strokeColor="@color/pure_br"
            app:strokeWidth="1dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="12dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="TURBIDITY" android:textColor="@color/pure_mu" android:textSize="9sp" />
                <TextView android:id="@+id/tvTurbValue" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="1.2 NTU" android:textColor="@color/pure_cy" android:textStyle="bold" android:shadowColor="@color/pure_cy" android:shadowDx="0" android:shadowDy="0" android:shadowRadius="8" />
                <TextView android:id="@+id/tvTurbStatus" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Normal Range" android:textColor="@color/pure_dm" android:textSize="8sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Temperature -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:layout_margin="4dp"
            app:cardBackgroundColor="@color/pure_bg2"
            app:cardCornerRadius="12dp"
            app:strokeColor="@color/pure_br"
            app:strokeWidth="1dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="12dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="TEMPERATURE" android:textColor="@color/pure_mu" android:textSize="9sp" />
                <TextView android:id="@+id/tvTempValue" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="28.0 °C" android:textColor="@color/pure_cy" android:textStyle="bold" android:shadowColor="@color/pure_cy" android:shadowDx="0" android:shadowDy="0" android:shadowRadius="8" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Optimal" android:textColor="@color/pure_dm" android:textSize="8sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- pH Level -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:layout_margin="4dp"
            app:cardBackgroundColor="@color/pure_bg2"
            app:cardCornerRadius="12dp"
            app:strokeColor="@color/pure_br"
            app:strokeWidth="1dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="12dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="pH LEVEL" android:textColor="@color/pure_mu" android:textSize="9sp" />
                <TextView android:id="@+id/tvPhValue" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="7.2 pH" android:textColor="@color/pure_gn" android:textStyle="bold" android:shadowColor="@color/pure_gn" android:shadowDx="0" android:shadowDy="0" android:shadowRadius="8" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Neutral" android:textColor="@color/pure_dm" android:textSize="8sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Signal -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:layout_margin="4dp"
            app:cardBackgroundColor="@color/pure_bg2"
            app:cardCornerRadius="12dp"
            app:strokeColor="@color/pure_br"
            app:strokeWidth="1dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="12dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="SIGNAL" android:textColor="@color/pure_mu" android:textSize="9sp" />
                <TextView android:id="@+id/tvSignalValue" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="STRONG" android:textColor="@color/pure_gn" android:textStyle="bold" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="-42 dBm · WiFi" android:textColor="@color/pure_dm" android:textSize="8sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </GridLayout>

    <!-- Quick Actions Grid -->
    <LinearLayout
        android:id="@+id/quickActions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="16dp"
        android:orientation="horizontal"
        app:layout_constraintTop_toBottomOf="@id/sensorGrid">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/actionAlerts"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_margin="4dp"
            app:cardBackgroundColor="@color/pure_bg2"
            app:cardCornerRadius="10dp"
            app:strokeColor="@color/pure_br"
            app:strokeWidth="1dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="10dp" android:gravity="center">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🔔" android:textSize="18sp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="ALERTS" android:textColor="@color/pure_mu" android:textSize="8sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/actionMaint"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_margin="4dp"
            app:cardBackgroundColor="@color/pure_bg2"
            app:cardCornerRadius="10dp"
            app:strokeColor="@color/pure_br"
            app:strokeWidth="1dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="10dp" android:gravity="center">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🔧" android:textSize="18sp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="MAINT" android:textColor="@color/pure_mu" android:textSize="8sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/actionHistory"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_margin="4dp"
            app:cardBackgroundColor="@color/pure_bg2"
            app:cardCornerRadius="10dp"
            app:strokeColor="@color/pure_br"
            app:strokeWidth="1dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="10dp" android:gravity="center">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="📊" android:textSize="18sp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="HISTORY" android:textColor="@color/pure_mu" android:textSize="8sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/actionPump"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_margin="4dp"
            app:cardBackgroundColor="@color/pure_bg2"
            app:cardCornerRadius="10dp"
            app:strokeColor="@color/pure_br"
            app:strokeWidth="1dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="10dp" android:gravity="center">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="⚡" android:textSize="18sp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="PUMP" android:textColor="@color/pure_mu" android:textSize="8sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

    <!-- Bottom Navigation Area -->

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigation"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:background="#030A16"
        app:itemIconTint="@color/pure_mu"
        app:itemTextColor="@color/pure_mu"
        app:labelVisibilityMode="labeled"
        app:layout_constraintBottom_toBottomOf="parent"
        app:menu="@menu/bottom_nav_menu"
        tools:layout_editor_absoluteX="0dp" />

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabPump"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="35dp"
        android:src="@android:drawable/ic_lock_power_off"
        app:backgroundTint="@color/pure_cy"
        app:elevation="8dp"
        app:fabSize="normal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:tint="@color/pure_bg" />

</androidx.constraintlayout.widget.ConstraintLayout>